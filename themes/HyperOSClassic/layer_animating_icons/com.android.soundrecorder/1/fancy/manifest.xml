<?xml version="1.0" encoding="utf-8"?>
<Icon version="1" frameRate="0" width="351" height="351" screenWidth="1080">
    <ExternalCommands>
        <!-- 初始化 使用同级目录静态资源 -->
        <Trigger action="init,present,back_home_cancel">
            <VariableCommand name="useQuietImage" type="number" expression="1" />
        </Trigger>

        <!-- 开始返回桌面，动画还原到第一帧 -->
        <Trigger action="back_home_start">
            <FrameRateCommand rate="60" />
            <LottieCommand target="icon" command="goToAndStop" params="0" />
            <VariableCommand name="useQuietImage" type="number" expression="0" />
        </Trigger>

        <!-- 已经回到桌面，播放动画 -->
        <Trigger action="back_home_finish">
            <FrameRateCommand rate="60" />
            <LottieCommand target="icon" command="play" />
        </Trigger>
    </ExternalCommands>

    <Lottie name="icon" src="com.android.soundrecorder.json" x="351 / 2" y="351 / 2" align="center" alignV="center" autoplay="false" loop="0" w="351" h="351">
        <Triggers>
            <Trigger action="complete">
                <!-- 播放完成（注意循环播放下不会触发complete） -->
                <VariableCommand name="useQuietImage" type="number" expression="1" />
                <FrameRateCommand rate="0" />
            </Trigger>
        </Triggers>
    </Lottie>
</Icon>